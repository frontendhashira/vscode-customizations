{
  /** ------------ General Editor Settings ------------ **/
  // "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": false,
  "editor.guides.bracketPairs": true,
  "editor.fontLigatures": true,
  "editor.linkedEditing": true,
  "editor.insertSpaces": true,
  "editor.padding.bottom": 2,
  "editor.tabSize": 3,
  "editor.letterSpacing": 0.5,
  "editor.renderWhitespace": "none",
  "editor.formatOnPaste": true,
  "editor.formatOnType": true,
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.codeLensFontFamily": "JetBrains Mono",
  "editor.codeLensFontSize": 10,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.indentSize": 3,
  "editor.minimap.autohide": true,
  "editor.wordWrapColumn": 250,
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.autoIndent": "none",
  // "editor.codeActionsOnSave": {
  //   "source.fixAll.stylelint": "explicit",
  //   "quickfix.biome": "explicit",
  //   "source.organizeImports.biome": "explicit"
  // }
  "editor.fontFamily": "'Fira Code Retina','Brass Mono Regular', 'Hack Nerd Font', iosevka, Operator Mono, Fira Code iScript, MonoLisa, Victor Mono, Fira Code, JetBrains Mono, monofur for powerline, Meslo LG M Regular for Powerline, Range, Source Code Pro, Anonymous Pro, 'Courier New', monospace ",
  "editor.fontSize": 15,
  "editor.fontWeight": 450,
  "editor.lineHeight": 26,
  "editor.folding": true,
  "editor.glyphMargin": true,
  "editor.guides.indentation": false,
  // "editor.scrollbar.horizontal": "hidden",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.wordWrap": "on",
  "editor.stickyScroll.enabled": true,
  "editor.quickSuggestionsDelay": 5,
  "editor.foldingStrategy": "indentation",
  "editor.suggest.shareSuggestSelections": true,
  "editor.snippetSuggestions": "bottom",
  "editor.suggest.showStatusBar": true,
  "editor.cursorBlinking": "expand",
  "editor.quickSuggestions": {
    "strings": "on",
    "comments": "on"
  },
  /** ------------ Workbench Settings ------------ **/
  "workbench.editor.enablePreview": false,
  "workbench.colorCustomizations": {
    "inlineparameters.annotationBackground": "#282A3600",
    "inlineparameters.annotationForeground": "#7b82af",
    "scrollbar.shadow": "#24292e00"
  },
  "workbench.editorLargeFileConfirmation": 10024,
  "workbench.layoutControl.enabled": false,
  // "workbench.editor.showTabs": "single",
  "workbench.tree.indent": 16,
  "workbench.editor.empty.hint": "hidden",
  "workbench.tree.enableStickyScroll": false,
  "workbench.startupEditor": "none",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.sideBar.location": "right",
  // Monokai Pro (Filter Ristretto) | Material Theme Ocean High Contrast | One Dark Pro* Darker | Bearded Monokai | Gruvbox
  "workbench.colorTheme": "GitHub Dark Default",
  /** ------------ Breadcrumbs Configurations ------------ **/
  "breadcrumbs.enabled": false,
  "breadcrumbs.symbolPath": "off",
  "breadcrumbs.filePath": "on",
  /** ------------ Terminal Configurations ------------ **/
  "terminal.integrated.fontFamily": "'MesloLGS NF', 'Hack Nerd Font', Monospace,Iosevka Term Slab, Iosevka Term,  CaskaydiaCove NFM",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.lineHeight": 1,
  "terminal.explorerKind": "external",
  "terminal.integrated.accessibleViewFocusOnCommandExecution": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.env.linux": {},
  "terminal.integrated.env.windows": {},
  "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  /** ------------ Git Settings ------------ **/
  "git.suggestSmartCommit": true,
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  /** ------------ Prettier Settings ------------ **/
  "prettier.enableDebugLogs": true,
  "prettier.useTabs": false,
  "prettier.semi": true,
  "prettier.singleQuote": true,
  "prettier.jsxSingleQuote": true,
  "prettier.arrowParens": "always",
  "prettier.bracketSpacing": true,
  "prettier.bracketSameLine": true,
  "prettier.trailingComma": "all",
  "prettier.printWidth": 200,
  "prettier.tabWidth": 2,
  "prettier.useEditorConfig": false,
  /** ------------ Files Settings ------------ **/
  "files.autoSave": "afterDelay",
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.autoSaveDelay": 400,
  "files.associations": {
    ".js": "javascriptreact",
    "*.jsx": "javascriptreact",
    // "*.css": "tailwindcss",
    "*.astro": "astro"
  },
  /** ------------ Language-Specific Settings ------------ **/
  /** ------------ HTML Formatting ------------ **/
  "html.format.indentInnerHtml": true,
  "html.format.indentHandlebars": true,
  "html.format.wrapLineLength": 250,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.colorDecorators": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
      "quickfix.biome": "explicit",
      "source.organizeImports.biome": "explicit",
      "source.action.useSortedAttributes.biome": "explicit",
      "source.action.useSortedKeys.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
      "quickfix.biome": "explicit",
      "source.organizeImports.biome": "explicit",
      "source.action.useSortedAttributes.biome": "explicit",
      "source.action.useSortedKeys.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
      "quickfix.biome": "explicit",
      "source.organizeImports.biome": "explicit",
      "source.action.useSortedAttributes.biome": "explicit",
      "source.action.useSortedKeys.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
      "quickfix.biome": "explicit",
      "source.organizeImports.biome": "explicit",
      "source.action.useSortedAttributes.biome": "explicit",
      "source.action.useSortedKeys.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
      "source.action.useSortedKeys.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.renderWhitespace": "all",
    "editor.acceptSuggestionOnEnter": "off"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome",
    "diffEditor.codeLens": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "explicit",
      "quickfix.biome": "explicit",
      "source.action.useSortedProperties.biome": "explicit",
      "source.fixAll.biome": "explicit"
    }
  },
  "[scss]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  /** ------------ JSON Settings ------------ **/
  "json.maxItemsComputed": 20000,
  "json.format.keepLines": false,
  /** ------------ CSS Settings ------------ **/
  "css.validate": true,
  "cssPeek.peekFromLanguages": [
    "html",
    "django-html",
    "laravel-blade",
    "razor",
    "vue",
    "blade",
    "pug",
    "jade",
    "handlebars",
    "php",
    "twig",
    "md",
    "nunjucks",
    "javascript",
    "javascriptreact",
    "erb",
    "typescript",
    "typescriptreact",
    "HTML (Eex)",
    "html-eex",
    "ejs",
    "hbs",
    "svelte",
    "css"
  ],
  /** ------------ TailwindCSS Settings ------------ **/
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "javascript": "javascript",
    "css": "css",
    "astro": "astro"
  },
  "tailwindCSS.emmetCompletions": true,
  /** ------------ Diff Editor Settings ------------ **/
  "diffEditor.diffAlgorithm": "advanced",
  "diffEditor.codeLens": true,
  /** ------------ Emmet Settings ------------ **/
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    // "typescriptreact": "html",
    "astro": "html"
  },
  "emmet.triggerExpansionOnTab": true,
  /** ------------ TypeScript Settings ------------ **/
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  /** ------------ Extension Settings ------------ **/
  "codeium.enableConfig": {
    "*": true,
    "terminal": true,
    "motoko": true,
    "tailwindcss": true
  },
  "todo-tree.highlights.useColourScheme": true,
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "fontWeight": "thin",
      "icon": "checklist"
    },
    "FIXME": {
      "foreground": "#ffffff",
      "iconColour": "#ff0000",
      "background": "#ff0000",
      "icon": "alert-fill",
      "fontWeight": "thin"
    }
  },
  "todo-tree.general.tagGroups": {
    "FIXME": [
      "FIXME",
      "FIXIT",
      "FIX"
    ]
  },
  "todo-tree.regex.regex": "(//)\\s*($TAGS).*(\\n\\s*//\\s{2,}.*)*",
  "vscord.behaviour.debug": true,
  "vscord.status.idle.disconnectOnIdle": true,
  "vscord.status.idle.resetElapsedTime": true,
  "vscord.behaviour.statusBarAlignment": "Left",
  "quokka.automaticRestart": true,
  "previewServer.port": 8085,
  "svgPreview.autoOpen": false,
  "stylelint.validate": [
    "css",
    "scss",
    "tailwindcss"
  ],
  "liveSassCompile.settings.formats": [
    {
      "format": "compressed",
      "extensionName": ".css",
      "savePath": "/dist",
      "savePathReplacementPairs": null,
    }
  ],
  /** ------------ Indent Rainbow Settings ------------ **/
  "indentRainbow.ignoreErrorLanguages": [
    "*"
  ],
  "indentRainbow.indicatorStyle": "light",
  "indentRainbow.lightIndicatorStyleLineWidth": 1,
  "indentRainbow.colors": [
    "rgba(255,255,64,0.3)",
    "rgba(127,255,127,0.3)",
    "rgba(255,127,255,0.3)",
    "rgba(79,236,236,0.3)"
  ],
  /** ------------ GitHub Copilot Settings ------------ **/
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "javascript": false,
    "html": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  /** ------------ Inline Chat Settings ------------ **/
  "inlineChat.hideOnRequest": true,
  "inlineChat.enableV2": true,
  /** ------------ Security & System Settings ------------ **/
  "security.allowedUNCHosts": [
    "wsl.localhost"
  ],
  "security.workspace.trust.untrustedFiles": "open",
  "remote.autoForwardPortsSource": "hybrid",
  "accessibility.underlineLinks": true,
  "accessibility.hideAccessibleView": true,
  "application.shellEnvironmentResolutionTimeout": 30,
  /** ------------ Window Settings ------------ **/
  "window.restoreFullscreen": true,
  "window.menuBarVisibility": "toggle",
  "window.titleBarStyle": "custom",
  /** ------------ Custom CSS ------------ **/
  "vscode_custom_css.imports": [
    "file:///C:/Users/ridwan/.vscode/vscode-custom/style.css",
    "file:///C:/Users/ridwan/.vscode/vscode-custom/script.js"
  ],
  "biome.suggestInstallingGlobally": false,
  /** Explorer **/
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "update.mode": "none"
}